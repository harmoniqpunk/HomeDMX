////////////////////////////////////////////////////////////
//                                                        //
//    HomeSpan: A HomeKit implementation for the ESP32    //
//    ------------------------------------------------    //
//                                                        //
// HomeDMX: HomeKit to DMX Bridge                         //
//                                                        //
////////////////////////////////////////////////////////////

#include "HomeSpan.h"

// Include config file with WiFi credentials
#include "config.h"

// Check for WiFi credentials
#ifndef HOMEDMX_WIFI_SSID
#error "Please set HOMEDMX_WIFI_SSID environment variable with your WiFi SSID"
#endif

#ifndef HOMEDMX_WIFI_PASS
#error "Please set HOMEDMX_WIFI_PASS environment variable with your WiFi password"
#endif

const char* WIFI_SSID = HOMEDMX_WIFI_SSID;
const char* WIFI_PASSWORD = HOMEDMX_WIFI_PASS;

// Status LED pin - ESP32 Thing Plus has a built-in LED on pin 13
const int STATUS_LED_PIN = 13;
// Control button pin - you can add a physical button for reset/configuration
const int CONTROL_BUTTON_PIN = 0;  // Built-in BOOT button on ESP32

// Simple light
struct DEV_Light : Service::LightBulb {
  SpanCharacteristic *power;
  SpanCharacteristic *brightness;
  
  DEV_Light(const char* name) : Service::LightBulb() {
    power = new Characteristic::On(false);
    brightness = new Characteristic::Brightness(50);
    new Characteristic::Name(name);
  }
  
  boolean update() override {
    // Just log the state changes
    if(power->getNewVal()) {
      Serial.print("Power: ");
      Serial.println(power->getVal() ? "ON" : "OFF");
    }
    
    if(brightness->getNewVal()) {
      Serial.print("Brightness: ");
      Serial.println(brightness->getVal());
    }
    
    return true;
  }
};

void setup() {
  Serial.begin(115200);
  delay(100);
  
  // Set up the status LED
  pinMode(STATUS_LED_PIN, OUTPUT);
  digitalWrite(STATUS_LED_PIN, LOW);
  
  // Set up the control button
  pinMode(CONTROL_BUTTON_PIN, INPUT_PULLUP);
  
  // Set up WiFi credentials
  homeSpan.setWifiCredentials(WIFI_SSID, WIFI_PASSWORD);
  
  // Initialize HomeSpan
  homeSpan.begin(Category::Lighting, "HomeDMX", "HomeDMX Bridge", "123-ABC");
  
  // Create the bridge device
  new SpanAccessory();
    new Service::AccessoryInformation();
      new Characteristic::Name("HomeDMX Bridge");
      new Characteristic::Manufacturer("DIY");
      new Characteristic::SerialNumber("123-ABC");
      new Characteristic::Model("HomeDMX");
      new Characteristic::FirmwareRevision("1.0");
      new Characteristic::Identify();
  
  // Simple light
  new SpanAccessory();
    new Service::AccessoryInformation();
      new Characteristic::Identify();
      new Characteristic::Name("Light 1");
      new Characteristic::Manufacturer("DIY");
      new Characteristic::SerialNumber("123-ABC");
      new Characteristic::Model("Light");
      new Characteristic::FirmwareRevision("1.0");
    
    new DEV_Light("Light 1");
}

void loop() {
  homeSpan.poll();
}
